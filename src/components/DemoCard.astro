---
interface Props {
  title: string;
  description: string;
  badge: string;
  tone: string;
  link?: string;
  index: number;
}

import Card from '@components/ui/Card.astro';
const { title, description, badge, tone, link, index } = Astro.props;
---

<Card interactive class="demo-card p-7">
  <div class="flex items-center justify-between">
    <span class={`rounded-full border border-line bg-paper px-3 py-1 text-[11px] font-bold ${tone}`}
      >{badge}</span
    >
    <span class="text-xl text-muted" dir="ltr">0{index + 1}</span>
  </div>
  <h3 class="mt-8 font-heading text-2xl font-bold text-ink">{title}</h3>
  <p class="mt-3 min-h-14 text-sm leading-7 text-muted">{description}</p>
  {
    link ? (
      <a
        class="mt-7 block border-t border-line pt-4 text-sm font-bold text-moss transition-colors hover:text-moss-dark"
        href={link}
      >
        معاينة النموذج ←
      </a>
    ) : (
      <div class="mt-7 border-t border-line pt-4 text-sm font-bold text-muted">يُبنى تدريجياً</div>
    )
  }
</Card>
