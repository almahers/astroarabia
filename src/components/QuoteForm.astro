---
import Button from '@components/ui/Button.astro';
---

<form id="quote" class="space-y-5">
  <div class="grid gap-5 sm:grid-cols-2">
    <label class="space-y-2 text-sm font-bold text-ink">
      <span>الاسم</span>
      <input
        required
        name="name"
        type="text"
        autocomplete="name"
        class="w-full rounded-xl border border-line bg-white px-4 py-3 font-normal outline-none transition focus:border-transparent focus:ring-2 focus:ring-primary-500 dark:bg-[#102a2b]"
        placeholder="اسمك الكريم"
      />
    </label>
    <label class="space-y-2 text-sm font-bold text-ink">
      <span>رقم الجوال</span>
      <input
        required
        name="phone"
        type="tel"
        inputmode="tel"
        dir="ltr"
        class="w-full rounded-xl border border-line bg-white px-4 py-3 text-right font-normal outline-none transition focus:border-transparent focus:ring-2 focus:ring-primary-500 dark:bg-[#102a2b]"
        placeholder="05xxxxxxxx"
      />
    </label>
  </div>
  <label class="block space-y-2 text-sm font-bold text-ink">
    <span>ما الذي تحتاجه؟</span>
    <select
      name="service"
      class="w-full rounded-xl border border-line bg-white px-4 py-3 font-normal outline-none transition focus:border-transparent focus:ring-2 focus:ring-primary-500 dark:bg-[#102a2b]"
    >
      <option>موقع شركة وخدمات</option>
      <option>متجر أو منتج رقمي</option>
      <option>تحسين موقع قائم</option>
    </select>
  </label>
  <label class="block space-y-2 text-sm font-bold text-ink">
    <span>رسالة مختصرة</span>
    <textarea
      name="message"
      rows="4"
      class="w-full resize-y rounded-xl border border-line bg-white px-4 py-3 font-normal outline-none transition focus:border-transparent focus:ring-2 focus:ring-primary-500 dark:bg-[#102a2b]"
      placeholder="حدثنا عن مشروعك"></textarea>
  </label>
  <Button type="submit" icon="✓" class="w-full">إرسال الطلب</Button>
  <p class="text-center text-xs leading-6 text-muted">
    النموذج واجهة جاهزة للتخصيص؛ اربطه بخدمة الإرسال المناسبة لمشروعك قبل النشر.
  </p>
</form>
