---
interface Props {
  number: string;
  title: string;
  description: string;
}
const { number, title, description } = Astro.props;
---

<article class="border-t-2 border-moss py-6">
  <span class="text-sm font-bold text-coral" dir="ltr">{number}</span>
  <h3 class="mt-3 text-xl font-bold text-ink">{title}</h3>
  <p class="mt-2 text-sm leading-8 text-muted">{description}</p>
</article>
