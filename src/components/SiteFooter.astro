---
interface Props {
  variant?: 'light' | 'dark';
}
const { variant = 'light' } = Astro.props;
const isDark = variant === 'dark';
const tone = isDark ? 'text-white/60' : 'text-muted';
const border = isDark ? 'border-white/10' : 'border-line';
const aiPrompt =
  'أنا أقيّم قالب AstroArabia لموقعي. أعطني ملخصًا عربيًا واضحًا عن المميزات، نقاط القوة، وأفضل طريقة للبدء.';
const aiLinks = [
  {
    title: 'ChatGPT',
    href: `https://chatgpt.com/?prompt=${encodeURIComponent(aiPrompt)}`,
    label: 'اسأل ChatGPT',
    icon: '🤖',
  },
  {
    title: 'Claude',
    href: `https://claude.ai/new?q=${encodeURIComponent(aiPrompt)}`,
    label: 'اسأل Claude',
    icon: '✨',
  },
  {
    title: 'Perplexity',
    href: `https://www.perplexity.ai/search?q=${encodeURIComponent(aiPrompt)}`,
    label: 'اسأل Perplexity',
    icon: '🔎',
  },
  {
    title: 'Gemini',
    href: `https://gemini.google.com/app?prompt=${encodeURIComponent(aiPrompt)}`,
    label: 'اسأل Gemini',
    icon: '💠',
  },
];
---

<footer class={`border-t ${border} ${isDark ? 'site-footer-dark text-white' : 'bg-white text-ink'}`}>
  <div class="container grid grid-cols-2 gap-8 py-12 md:grid-cols-4">
    <div>
      <a href="/" class="font-heading text-xl font-bold"
        >Astro<span class={isDark ? 'text-coral' : 'text-moss'}>Arabia</span></a
      ><p class="mt-2 max-w-xs text-sm leading-7 text-gray-500 dark:text-white/60">
        قالب سعودي عربي سريع، معمول للمطورين والفرق اللي تبغى تطلق بثقة.
      </p>
    </div>
    <div>
      <h2 class={`text-sm font-bold ${isDark ? 'text-white' : 'text-gray-900'} dark:text-white`}>
        قوالب جاهزة
      </h2><nav
        class="mt-4 grid gap-2 text-sm text-gray-500 dark:text-white/60"
        aria-label="روابط النماذج"
      >
        <a
          href="/agency"
          class="transition-colors hover:-translate-x-1 hover:translate-x-reverse-1 hover:text-primary-600"
          >شركات وخدمات</a
        ><a
          href="/saas"
          class="transition-colors hover:-translate-x-1 hover:translate-x-reverse-1 hover:text-primary-600"
          >SaaS</a
        ><a
          href="/portfolio"
          class="transition-colors hover:-translate-x-1 hover:translate-x-reverse-1 hover:text-primary-600"
          >معرض أعمال</a
        ><a
          href="/landing"
          class="transition-colors hover:-translate-x-1 hover:translate-x-reverse-1 hover:text-primary-600"
          >صفحة الهبوط</a
        >
      </nav>
    </div>
    <div>
      <h2 class={`text-sm font-bold ${isDark ? 'text-white' : 'text-gray-900'} dark:text-white`}>
        للمطورين
      </h2><nav
        class="mt-4 grid gap-2 text-sm text-gray-500 dark:text-white/60"
        aria-label="روابط المعرفة"
      >
        <a
          href="/docs"
          class="transition-colors hover:-translate-x-1 hover:translate-x-reverse-1 hover:text-primary-600"
          >التوثيق السريع</a
        ><a
          href="/docs#quick-start"
          class="transition-colors hover:-translate-x-1 hover:translate-x-reverse-1 hover:text-primary-600"
          >ابدأ من هنا</a
        ><a
          href="/blog"
          class="transition-colors hover:-translate-x-1 hover:translate-x-reverse-1 hover:text-primary-600"
          >المدونة</a
        ><a
          href="/docs#new-preset"
          class="transition-colors hover:-translate-x-1 hover:translate-x-reverse-1 hover:text-primary-600"
          >خصّص القالب</a
        >
      </nav>
    </div>
    <div>
      <h2 class={`text-sm font-bold ${isDark ? 'text-white' : 'text-gray-900'} dark:text-white`}>
        معلومات مهمة
      </h2><nav
        class="mt-4 grid gap-2 text-sm text-gray-500 dark:text-white/60"
        aria-label="الروابط القانونية"
      >
        <a
          href="/privacy"
          class="transition-colors hover:-translate-x-1 hover:translate-x-reverse-1 hover:text-primary-600"
          >الخصوصية</a
        ><a
          href="/terms"
          class="transition-colors hover:-translate-x-1 hover:translate-x-reverse-1 hover:text-primary-600"
          >الشروط</a
        ><a
          href="/LICENSE.txt"
          class="transition-colors hover:-translate-x-1 hover:translate-x-reverse-1 hover:text-primary-600"
          >الرخصة MIT</a
        >
      </nav>
    </div>
    <div class="md:mt-5 mt-14">
      <div class={`mb-3 text-xs font-bold ${isDark ? 'text-white/70' : 'text-muted'}`}>
        اسأل الذكاء الاصطناعي عن AstroArabia:
      </div>
      <div class="flex items-center justify-center gap-4 lg:justify-start">
        {
          aiLinks.map((link) => (
            <a
              class={`footer-ai-link inline-flex h-11 w-11 items-center justify-center rounded-full border text-lg transition hover:-translate-y-0.5 hover:text-white ${
                isDark
                  ? 'border-white/10 bg-white/5 text-white/80 hover:bg-moss hover:border-moss'
                  : 'border-line bg-paper text-ink hover:bg-moss hover:border-moss'
              }`}
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              title={link.title}
              aria-label={link.label}
            >
              <span aria-hidden="true">{link.icon}</span>
            </a>
          ))
        }
      </div>
    </div>
  </div>
  <div class={`border-t ${border}`}>
    <div
      class={`container flex flex-col justify-between gap-3 py-5 text-xs sm:flex-row sm:items-center ${tone}`}
    >
      <span>© 2026 أسترو أرابيا. قالب عربي جاهز للتخصيص والنشر.</span><span dir="ltr"
        >Astro · Tailwind CSS · RTL-first</span
      >
    </div>
  </div>
</footer>
