---
interface Props {
  variant?: 'light' | 'dark';
}
const { variant = 'light' } = Astro.props;
const isDark = variant === 'dark';
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const navigation = [
  { href: '/#features', label: 'ليش AstroArabia؟', path: '/' },
  { href: '/agency', label: 'للشركات', path: '/agency' },
  { href: '/saas', label: 'للمنتجات', path: '/saas' },
  { href: '/portfolio', label: 'الأعمال', path: '/portfolio' },
  { href: '/landing', label: 'صفحات الهبوط', path: '/landing' },
  { href: '/docs', label: 'للمطورين', path: '/docs' },
  { href: '/blog', label: 'المدونة', path: '/blog' },
  { href: '/agency#quote', label: 'كلّمنا', path: '/agency' },
];
const isCurrentItem = (item: (typeof navigation)[number]) =>
  !item.href.includes('#') && currentPath === item.path;
---

<header
  class={`site-header sticky top-0 z-40 border-b shadow-sm backdrop-blur-xl ${isDark ? 'site-header-dark border-white/10 bg-[#102a2b]/90 shadow-black/10' : 'border-line bg-paper/90 shadow-black/5'}`}
  data-header
>
  <div class="container flex min-h-20 items-center justify-between gap-3 sm:gap-5">
    <a
      href="/"
      class={`shrink-0 font-heading text-lg font-bold tracking-tight sm:text-xl ${isDark ? 'text-white' : 'text-ink'}`}
      aria-label="AstroArabia - الصفحة الرئيسية"
    >
      Astro<span class={isDark ? 'text-coral' : 'text-moss'}>Arabia</span>
    </a>
    <nav
      aria-label="التنقل الرئيسي"
      class={`hidden items-center gap-6 text-sm font-semibold lg:flex ${isDark ? 'text-white/70' : 'text-muted'}`}
    >
      {
        navigation.map((item) => (
          <a
            class={`transition-colors hover:text-moss ${isCurrentItem(item) ? (isDark ? 'text-white' : 'text-moss') : ''}`}
            href={item.href}
            aria-current={isCurrentItem(item) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    <div class="flex items-center gap-2">
      <details class="relative lg:hidden">
        <summary
          class={`cursor-pointer list-none rounded-xl border px-3 py-2 text-sm font-bold ${isDark ? 'border-white/20 text-white' : 'border-line text-moss'}`}
          ><span aria-hidden="true">☰</span><span class="sr-only">القائمة</span></summary
        >
        <nav
          aria-label="التنقل للجوال"
          class={`absolute end-0 top-12 z-20 grid min-w-44 gap-1 rounded-2xl border p-2 text-sm font-semibold shadow-xl ${isDark ? 'border-white/10 bg-[#102a2b] text-white/80' : 'border-line bg-white text-muted'}`}
        >
          {
            navigation.map((item) => (
              <a
                class={`rounded-lg px-3 py-2 transition-colors ${isCurrentItem(item) ? (isDark ? 'border-s-2 border-coral bg-white/10 text-white' : 'border-s-2 border-moss bg-paper text-moss') : isDark ? 'text-white/55 hover:bg-white/10 hover:text-white' : 'text-muted hover:bg-paper hover:text-moss'}`}
                href={item.href}
                aria-current={isCurrentItem(item) ? 'page' : undefined}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
      </details>
      <button
        type="button"
        class={`theme-toggle theme-toggle-btn grid h-10 w-10 place-items-center rounded-xl border transition ${isDark ? 'border-white/20 text-white/80 hover:border-coral hover:text-white' : 'border-line text-muted hover:border-moss hover:text-moss'}`}
        data-theme-toggle
        aria-label="تفعيل الوضع الليلي"
        title="تبديل الوضع الليلي"
        ><span class="theme-toggle-icon" aria-hidden="true"></span><span class="sr-only">تبديل الوضع الليلي</span></button
      >
      <a
        href="/agency#quote"
        class="rounded-full bg-moss px-3.5 py-2.5 text-sm font-bold text-white transition-colors hover:bg-moss-dark sm:px-5"
        ><span class="text-xl font-normal leading-none" aria-hidden="true">↗</span><span
          class="hidden sm:inline"
        >
          خلّنا نبدأ</span
        ><span class="sr-only">خلّنا نبدأ</span></a
      >
    </div>
  </div>
</header>
<script>
  const themeButton = document.querySelector('[data-theme-toggle]');
  const savedTheme = localStorage.getItem('astroarabia-theme');
  const preferredTheme: 'light' | 'dark' = window.matchMedia('(prefers-color-scheme: dark)').matches
    ? 'dark'
    : 'light';
  const setTheme = (theme: 'light' | 'dark') => {
    document.documentElement.dataset.theme = theme;
    document.documentElement.classList.toggle('dark', theme === 'dark');
    themeButton?.setAttribute(
      'aria-label',
      theme === 'dark' ? 'تفعيل الوضع النهاري' : 'تفعيل الوضع الليلي',
    );
  };
  const initialTheme: 'light' | 'dark' =
    savedTheme === 'dark' || savedTheme === 'light' ? savedTheme : preferredTheme;
  setTheme(initialTheme);
  themeButton?.addEventListener('click', () => {
    const nextTheme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    localStorage.setItem('astroarabia-theme', nextTheme);
    setTheme(nextTheme);
  });
  const header = document.querySelector('[data-header]');
  const updateHeader = () => header?.classList.toggle('is-scrolled', window.scrollY > 12);
  updateHeader();
  window.addEventListener('scroll', updateHeader, { passive: true });
</script>
