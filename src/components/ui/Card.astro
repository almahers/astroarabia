---
import { cva, type VariantProps } from 'class-variance-authority';
import { cn } from '@lib/cn';

const card = cva('rounded-2xl border transition-all duration-300', {
  variants: {
    variant: {
      default: 'border-line bg-white dark:border-white/10 dark:bg-[#102a2b]',
      muted: 'border-line bg-paper dark:border-white/10 dark:bg-[#0d211e]',
    },
    interactive: {
      true: 'hover:-translate-y-1 hover:border-moss/40 hover:shadow-lg hover:shadow-moss/10',
      false: '',
    },
  },
  defaultVariants: { variant: 'default', interactive: false },
});

interface Props extends VariantProps<typeof card> {
  class?: string;
}
const { variant, interactive, class: className } = Astro.props;
---

<article class={cn(card({ variant, interactive }), className)}><slot /></article>
