---
import BaseLayout from '@layouts/BaseLayout.astro';
import QuoteForm from '@components/QuoteForm.astro';
import ServiceCard from '@components/ServiceCard.astro';
import { Image } from 'astro:assets';
import workspaceImage from '../../assets/workspace.jpg';
import launchTeamImage from '../../assets/launch-team.jpg';

const solutions = [
  {
    number: '01',
    title: 'المواقع المؤسسية',
    description: 'بنية رقمية تعكس مكانة شركتك وتعرض خدماتها وقطاعاتها بوضوح وثقة.',
  },
  {
    number: '02',
    title: 'بوابات الخدمات',
    description: 'تجارب مرتبة تساعد العملاء والشركاء على الوصول إلى المعلومة والإجراء المناسب.',
  },
  {
    number: '03',
    title: 'الحملات الرقمية',
    description: 'صفحات مركزة للحملات والمبادرات والمنتجات الجديدة، مصممة لنتيجة قابلة للقياس.',
  },
];

const sectors = ['الاستشارات والخدمات المهنية', 'التقنية والمنتجات الرقمية', 'العقار والضيافة', 'التعليم والتدريب'];

const process = [
  ['الاستراتيجية', 'نفهم أهداف العمل والجمهور ونحدد الرسالة التي يجب أن تصل أولاً.'],
  ['الهيكلة والتصميم', 'نبني تجربة متماسكة تحول المعلومات المعقدة إلى مسارات سهلة وواضحة.'],
  ['التطوير والإطلاق', 'نطور على أساس سريع وقابل للتوسع، ثم نجهز الموقع للنشر والتحسين المستمر.'],
];
---

<BaseLayout
  title="حلول رقمية للشركات | AstroArabia"
  description="حلول رقمية عربية للشركات: مواقع مؤسسية، بوابات خدمات، وتجارب رقمية سريعة وقابلة للنمو."
>
  <section class="border-b border-line bg-[#102a2b] text-white">
    <div class="container grid items-center gap-12 py-20 sm:py-28 lg:grid-cols-[1.05fr_.95fr]">
      <div>
        <p class="text-sm font-bold text-emerald-300">حلول رقمية للشركات</p>
        <h1 class="mt-5 max-w-3xl font-heading text-4xl font-bold leading-[1.55] sm:text-6xl">
          حضور رقمي يليق<br /><span class="text-coral">بعملك المؤسسي.</span>
        </h1>
        <p class="mt-7 max-w-2xl text-lg leading-9 text-white/70">
          نصمم ونطور تجارب رقمية تساعد الشركات على شرح قيمتها، بناء الثقة، وتحويل الفرص إلى علاقات
          عمل واضحة.
        </p>
        <div class="mt-9 flex flex-wrap gap-4">
          <a href="#contact" class="rounded-xl bg-coral px-7 py-3.5 font-bold text-white transition hover:bg-[#cf604b]">ناقش مشروعك</a>
          <a href="#solutions" class="rounded-xl border border-white/20 px-7 py-3.5 font-bold text-white/80 transition hover:border-white hover:text-white">استكشف الحلول</a>
        </div>
        <div class="mt-12 grid max-w-lg grid-cols-3 gap-5 border-t border-white/10 pt-6 text-sm">
          <div><strong class="block text-2xl text-white">RTL</strong><span class="text-white/55">عربي من الأصل</span></div>
          <div><strong class="block text-2xl text-white">Static</strong><span class="text-white/55">أداء ثابت</span></div>
          <div><strong class="block text-2xl text-white">SEO</strong><span class="text-white/55">أساس قابل للنمو</span></div>
        </div>
      </div>
      <div class="relative">
        <div class="absolute -inset-4 rounded-[2rem] border border-coral/20"></div>
        <div class="relative overflow-hidden rounded-3xl border border-white/10 bg-[#173b38] shadow-2xl shadow-black/30">
          <Image src={workspaceImage} alt="فريق يراجع استراتيجية رقمية لشركة" width={1600} height={1000} layout="constrained" sizes="(min-width: 1024px) 45vw, 100vw" class="h-80 w-full object-cover sm:h-[30rem]" />
          <div class="grid grid-cols-2 gap-px bg-white/10">
            <div class="bg-[#173b38] p-5"><p class="text-xs text-white/50">التركيز</p><p class="mt-2 font-bold">وضوح الأعمال</p></div>
            <div class="bg-coral p-5"><p class="text-xs text-white/75">النتيجة</p><p class="mt-2 font-bold">ثقة من أول زيارة</p></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="border-b border-line bg-paper">
    <div class="container grid gap-8 py-12 sm:grid-cols-3 sm:items-center">
      <div class="sm:border-s sm:border-line sm:ps-8"><p class="text-sm text-muted">نبدأ من سؤال واحد</p><p class="mt-2 font-heading text-xl font-bold">ما الذي يجب أن يفهمه عميلك الآن؟</p></div>
      <div class="sm:border-s sm:border-line sm:ps-8"><p class="text-sm text-muted">نبني حوله</p><p class="mt-2 font-heading text-xl font-bold">رسالة وتجربة ومسار قرار</p></div>
      <div><p class="text-sm text-muted">ونقيس النجاح بـ</p><p class="mt-2 font-heading text-xl font-bold">جودة الفرص لا كثرة الزيارات</p></div>
    </div>
  </section>

  <section id="solutions" class="container py-20 sm:py-28">
    <div class="grid gap-10 lg:grid-cols-[.7fr_1.3fr]">
      <div><p class="eyebrow">مجالات الحل</p><h2 class="mt-4 font-heading text-3xl font-bold sm:text-4xl">منصة رقمية تفهم عملك.</h2></div>
      <div><p class="max-w-2xl text-lg leading-9 text-muted">لا نبدأ من شكل جاهز. نبدأ من طريقة عمل شركتك، ثم نصمم تجربة تشرح ما تقدمه وتدعم أهدافك التجارية.</p><div class="mt-12 grid gap-5 md:grid-cols-3">{solutions.map((solution) => <ServiceCard {...solution} />)}</div></div>
    </div>
  </section>

  <section class="border-y border-line bg-white">
    <div class="container grid items-center gap-12 py-20 sm:py-28 lg:grid-cols-[.85fr_1.15fr]">
      <div class="overflow-hidden rounded-3xl"><Image src={launchTeamImage} alt="فريق يتعاون على إطلاق تجربة رقمية" width={1400} height={933} layout="constrained" sizes="(min-width: 1024px) 45vw, 100vw" class="h-80 w-full object-cover sm:h-[28rem]" /></div>
      <div><p class="eyebrow">شراكة عملية</p><h2 class="mt-4 max-w-2xl font-heading text-3xl font-bold sm:text-4xl">موقعك ليس ملفًا تعريفيًا. إنه جزء من عملك.</h2><p class="mt-6 max-w-2xl leading-9 text-muted">عندما تكون الخدمات والرسائل والطلبات مرتبة، يصبح الموقع أداة تساعد فريق المبيعات وخدمة العملاء والإدارة في وقت واحد.</p><div class="mt-8 grid gap-4 sm:grid-cols-2"><div class="border-s-2 border-moss ps-4"><p class="font-bold">رسائل أكثر اتساقًا</p><p class="mt-1 text-sm leading-7 text-muted">لغة واضحة عبر كل نقطة تواصل.</p></div><div class="border-s-2 border-coral ps-4"><p class="font-bold">قرارات أسرع</p><p class="mt-1 text-sm leading-7 text-muted">معلومة منظمة تقود إلى الإجراء.</p></div></div></div>
    </div>
  </section>

  <section class="container grid gap-12 py-20 sm:py-28 lg:grid-cols-[.7fr_1.3fr]">
    <div><p class="eyebrow">القطاعات</p><h2 class="mt-4 font-heading text-3xl font-bold sm:text-4xl">مرونة تناسب نماذج أعمال مختلفة.</h2><p class="mt-5 leading-8 text-muted">البنية قابلة للتكييف مع طبيعة شركتك، من عرض الخدمات إلى بناء بوابة معرفية متكاملة.</p></div>
    <div class="grid gap-3 sm:grid-cols-2">{sectors.map((sector, index) => <div class="flex items-center gap-4 border-b border-line py-5"><span class="text-sm font-bold text-coral" dir="ltr">0{index + 1}</span><span class="font-bold">{sector}</span></div>)}</div>
  </section>

  <section class="border-y border-line bg-paper">
    <div class="container grid gap-12 py-20 sm:py-28 lg:grid-cols-[.7fr_1.3fr]">
      <div><p class="eyebrow">منهجية التنفيذ</p><h2 class="mt-4 font-heading text-3xl font-bold sm:text-4xl">خطوات واضحة، وقرارات موثقة.</h2></div>
      <div class="grid gap-8 sm:grid-cols-3">{process.map(([title, description], index) => <article class="border-t-2 border-moss pt-5"><span class="text-sm font-bold text-coral" dir="ltr">0{index + 1}</span><h3 class="mt-3 font-heading text-xl font-bold">{title}</h3><p class="mt-3 text-sm leading-8 text-muted">{description}</p></article>)}</div>
    </div>
  </section>

  <section id="contact" class="bg-[#102a2b] text-white">
    <div class="container grid gap-12 py-20 sm:py-28 lg:grid-cols-[.8fr_1.2fr] lg:items-start">
      <div><p class="text-sm font-bold text-emerald-300">لنبدأ من احتياجك</p><h2 class="mt-4 font-heading text-3xl font-bold sm:text-4xl">شاركنا الصورة الكبيرة، وسنرتب التفاصيل.</h2><p class="mt-6 leading-8 text-white/65">اكتب نبذة عن شركتك وما تريد تحسينه. النموذج جاهز للتخصيص والربط بطريقة الإرسال التي تناسبك.</p><div class="mt-10 border-t border-white/10 pt-6 text-sm text-white/60"><p>موقع مؤسسي · بوابة خدمات · حملة رقمية</p><p class="mt-2" dir="ltr">hello@astroarabia.dev</p></div></div>
      <div class="rounded-2xl bg-white p-6 text-ink shadow-2xl sm:p-10"><QuoteForm /></div>
    </div>
  </section>

  <section class="bg-coral text-white"><div class="container flex flex-col justify-between gap-6 py-12 sm:flex-row sm:items-center"><div><p class="text-sm font-bold text-white/75">جاهز للخطوة التالية؟</p><h2 class="mt-2 font-heading text-3xl font-bold">اجعل حضور شركتك أكثر وضوحًا.</h2></div><a href="#contact" class="rounded-xl bg-[#102a2b] px-7 py-3.5 font-bold transition hover:bg-[#173b38]">ابدأ الحوار</a></div></section>
</BaseLayout>
