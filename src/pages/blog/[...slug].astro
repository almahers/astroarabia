---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import { SocialShare } from 'astro-social-share';
import { Image } from 'astro:assets';
import workspaceImage from '../../assets/workspace.jpg';
import launchTeamImage from '../../assets/launch-team.jpg';
import saasTeamImage from '../../assets/saas-team.jpg';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, posts } }));
}

const { post, posts } = Astro.props;
const { Content } = await render(post);
const coverImage = post.id === 'rtl-first' ? workspaceImage : launchTeamImage;
const relatedPosts = posts.filter((candidate) => candidate.id !== post.id).slice(0, 2);
const relatedImages = [saasTeamImage, launchTeamImage];
---

<BaseLayout title={`${post.data.title} | AstroArabia`} description={post.data.description}>
  <article class="container max-w-5xl py-16 sm:py-24">
    <header class="border-b border-line pb-10">
      <p class="eyebrow">{post.data.category}</p>
      <div class="grid items-end gap-10 lg:grid-cols-[1.1fr_.9fr]">
        <div><h1 class="mt-5 font-heading text-4xl font-bold leading-[1.55] sm:text-6xl">{post.data.title}</h1><p class="mt-6 text-lg leading-9 text-muted">{post.data.description}</p><div class="mt-8 flex flex-wrap items-center gap-4 text-sm text-muted"><time datetime={post.data.publishedAt.toISOString()}>{post.data.publishedAt.toLocaleDateString('ar-SA')}</time><span>·</span><span>{post.data.readingTime}</span></div><div class="mt-5 flex flex-wrap gap-2" aria-label="وسوم المقال">{post.data.tags.map((tag) => <span class="rounded-full border border-line bg-paper px-3 py-1 text-xs font-bold text-moss">#{tag}</span>)}</div></div>
        <div class="overflow-hidden rounded-3xl"><Image src={coverImage} alt="صورة توضيحية للمقال" width={1600} height={1000} layout="constrained" sizes="(min-width: 1024px) 40vw, 100vw" class="h-56 w-full object-cover sm:h-64" /></div>
      </div>
    </header>
    <div class="mt-12 grid min-w-0 gap-12 lg:grid-cols-[.28fr_.72fr]">
      <aside class="lg:sticky lg:top-28 lg:h-fit"><p class="eyebrow">في هذه المقالة</p><nav id="toc-container" data-server-toc data-max-depth="2" class="mt-4 grid gap-2" aria-label="فهرس المقالة"></nav></aside>
      <div class="min-w-0">
        <section class="mb-10 flex flex-wrap items-center justify-between gap-5 border-y border-line py-5"><p class="text-sm font-bold text-muted">شارك المقال</p><SocialShare title={post.data.title} description={post.data.description} /></section>
        <div id="article-content" class="prose prose-lg max-w-none leading-9 text-ink [&_a]:font-bold [&_a]:text-moss [&_a]:underline [&_a]:decoration-coral [&_a]:underline-offset-4 [&_blockquote]:my-8 [&_blockquote]:border-s-4 [&_blockquote]:px-5 [&_blockquote]:py-4 [&_blockquote]:font-bold [&_blockquote]:not-italic [&_.callout-insight]:border-moss [&_.callout-insight]:bg-emerald-50 [&_.callout-warning]:border-coral [&_.callout-warning]:bg-orange-50 [&_code]:rounded [&_code]:bg-paper [&_code]:px-1 [&_code]:text-moss [&_code]:[direction:ltr] [&_code]:[unicode-bidi:isolate] [&_h2]:mt-12 [&_h2]:scroll-mt-28 [&_h2]:font-heading [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:text-ink [&_h3]:mt-8 [&_h3]:font-heading [&_h3]:text-xl [&_h3]:font-bold [&_h3]:text-ink [&_p]:mt-5 [&_table]:mt-8 [&_table]:w-full [&_th]:border-b [&_th]:border-line [&_th]:p-3 [&_th]:text-center [&_td]:border-b [&_td]:border-line [&_td]:p-3 [&_td]:text-center [&_tr:last-child_td]:border-b-0 [&_ul]:mt-5"><Content /></div>
        <section class="mt-14 border-y border-line py-10"><p class="eyebrow">ملخص سريع</p><div class="mt-5 max-w-full overflow-x-auto rounded-2xl border border-line bg-white"><table class="w-full min-w-0 table-fixed border-collapse text-sm"><caption class="sr-only">ملخص توصيات بناء موقع عربي سريع</caption><thead><tr class="bg-paper"><th scope="col" class="border-b border-line px-3 py-4 text-center font-bold text-ink sm:px-4">العنصر</th><th scope="col" class="border-b border-line px-3 py-4 text-center font-bold text-ink sm:px-4">التوصية</th><th scope="col" class="border-b border-line px-3 py-4 text-center font-bold text-ink sm:px-4">الأثر</th></tr></thead><tbody><tr><th scope="row" class="border-b border-line px-3 py-4 text-center font-bold sm:px-4">البنية</th><td class="border-b border-line px-3 py-4 text-center sm:px-4" dir="ltr">Static HTML</td><td class="border-b border-line px-3 py-4 text-center text-muted sm:px-4">استجابة أسرع</td></tr><tr class="bg-paper/50"><th scope="row" class="border-b border-line px-3 py-4 text-center font-bold sm:px-4">الصور</th><td class="border-b border-line px-3 py-4 text-center sm:px-4" dir="ltr">Image وPicture</td><td class="border-b border-line px-3 py-4 text-center text-muted sm:px-4">حجم أقل وCLS أفضل</td></tr><tr><th scope="row" class="px-3 py-4 text-center font-bold sm:px-4">الاتجاه</th><td class="px-3 py-4 text-center sm:px-4" dir="ltr">RTL من المستند</td><td class="px-3 py-4 text-center text-muted sm:px-4">تجربة عربية طبيعية</td></tr></tbody></table></div></section>
        <section class="mt-14"><p class="eyebrow">أسئلة شائعة</p><h2 class="mt-3 font-heading text-2xl font-bold">أسئلة قبل التطبيق</h2><div class="mt-5 divide-y divide-line border-y border-line">{[['هل أحتاج إلى تطبيق كل الخطوات؟', 'ابدأ بالخطوة التي تحل أكبر مشكلة في مشروعك، ثم حسّن تدريجيًا.'], ['هل هذه التوصيات مناسبة للمواقع الصغيرة؟', 'نعم، صممت لتبدأ بها المشاريع الصغيرة ثم تتوسع عند الحاجة.']].map(([question, answer]) => <details class="group py-5"><summary class="flex cursor-pointer list-none justify-between gap-4 font-bold"><span>{question}</span><span class="text-xl text-moss transition group-open:rotate-45">+</span></summary><p class="mt-3 text-sm leading-8 text-muted">{answer}</p></details>)}</div></section>
        {relatedPosts.length > 0 && <section class="mt-16 border-t border-line pt-12"><div class="flex items-end justify-between gap-4"><div><p class="eyebrow">اقرأ المزيد</p><h2 class="mt-3 font-heading text-2xl font-bold">مقالتان قد تهمانك</h2></div><a href="/blog" class="text-sm font-bold text-moss">كل المقالات ←</a></div><div class="mt-6 grid gap-5 md:grid-cols-2">{relatedPosts.map((relatedPost, index) => <a href={`/blog/${relatedPost.id}`} class="group overflow-hidden rounded-2xl border border-line bg-paper transition hover:-translate-y-1 hover:shadow-lg"><Image src={relatedImages[index]} alt={`صورة مقال ${relatedPost.data.title}`} width={1200} height={800} layout="constrained" sizes="(min-width: 768px) 50vw, 100vw" class="h-48 w-full object-cover transition duration-500 group-hover:scale-105" /><div class="p-6"><p class="text-xs font-bold text-coral">{relatedPost.data.category} · {relatedPost.data.readingTime}</p><h3 class="mt-3 font-heading text-xl font-bold">{relatedPost.data.title}</h3><p class="mt-3 text-sm leading-7 text-muted">{relatedPost.data.description}</p><span class="mt-5 inline-block font-bold text-moss">اقرأ المقال ←</span></div></a>)}</div></section>}
      </div>
    </div>
    <footer class="mt-16 border-t border-line pt-8"><a href="/blog" class="font-bold text-moss">← العودة إلى المدونة</a></footer>
  </article>
</BaseLayout>
