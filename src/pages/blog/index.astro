---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import workspaceImage from '../../assets/workspace.jpg';
import saasTeamImage from '../../assets/saas-team.jpg';
import launchTeamImage from '../../assets/launch-team.jpg';

const posts = (await getCollection('blog')).sort(
  (first, second) => second.data.publishedAt.valueOf() - first.data.publishedAt.valueOf(),
);
const featuredPost = posts.find((post) => post.data.featured) ?? posts[0];
const otherPosts = posts.filter((post) => post.id !== featuredPost?.id);
const postImages = [saasTeamImage, launchTeamImage];
---

<BaseLayout
  title="مدونة AstroArabia | معرفة عربية للويب"
  description="مقالات عربية عن Astro وRTL وأداء الويب وبناء المنتجات الرقمية."
>
  <section class="border-b border-line bg-[#102a2b] text-white">
    <div class="container grid items-end gap-12 py-20 sm:py-28 lg:grid-cols-[1fr_.7fr]">
      <div>
        <p class="text-sm font-bold text-emerald-300">مدونة AstroArabia</p>
        <h1 class="mt-5 max-w-3xl font-heading text-4xl font-bold leading-[1.55] sm:text-6xl">
          معرفة عربية<br /><span class="text-coral">تبني بها أفضل.</span>
        </h1>
        <p class="mt-7 max-w-2xl text-lg leading-9 text-white/70">
          أفكار وتجارب عملية عن الويب العربي، Astro، الأداء، وتجربة المستخدم من منظور RTL.
        </p>
      </div>
      <div class="border-s-2 border-coral ps-6"><p class="text-sm text-white/55">نكتب عن</p><p class="mt-3 font-heading text-2xl font-bold">ما يساعدك على البناء، لا ما يملأ الصفحة.</p></div>
    </div>
  </section>

  {featuredPost && <section class="container py-20 sm:py-28"><div class="grid items-center gap-10 lg:grid-cols-[.7fr_1.3fr]"><div><p class="eyebrow">المقال المميز · {featuredPost.data.category}</p><h2 class="mt-4 font-heading text-3xl font-bold sm:text-5xl">{featuredPost.data.title}</h2><p class="mt-5 max-w-xl text-lg leading-9 text-muted">{featuredPost.data.description}</p><div class="mt-8 flex items-center gap-4 text-sm text-muted"><time datetime={featuredPost.data.publishedAt.toISOString()}>{featuredPost.data.publishedAt.toLocaleDateString('ar-SA')}</time><span>·</span><span>{featuredPost.data.readingTime}</span></div><a href={`/blog/${featuredPost.id}`} class="mt-8 inline-block rounded-xl bg-moss px-7 py-3.5 font-bold text-white transition hover:bg-moss-dark">اقرأ المقال</a></div><div class="overflow-hidden rounded-3xl bg-paper"><Image src={workspaceImage} alt="صورة المقال المميز" width={1600} height={1000} layout="constrained" sizes="(min-width: 1024px) 55vw, 100vw" class="h-72 w-full object-cover sm:h-96" /><div class="p-8 sm:p-12"><span class="text-7xl font-heading font-bold text-coral">01</span><p class="mt-8 max-w-md font-heading text-2xl font-bold leading-relaxed">العربية ليست طبقة فوق التصميم. هي طريقة تفكير.</p></div></div></div></section>}
  <section class="border-y border-line bg-paper"><div class="container py-20 sm:py-28"><div class="flex items-end justify-between gap-6"><div><p class="eyebrow">كل المقالات</p><h2 class="mt-4 font-heading text-3xl font-bold sm:text-4xl">اقرأ على مهل، وابنِ بوضوح.</h2></div><span class="text-sm text-muted">{posts.length} مقالات</span></div><div class="mt-12 grid gap-5 md:grid-cols-2">{otherPosts.map((post, index) => <article class="overflow-hidden border-t-2 border-moss bg-white"><Image src={postImages[index % postImages.length]} alt={`صورة مقال ${post.data.title}`} width={1200} height={800} layout="constrained" sizes="(min-width: 768px) 50vw, 100vw" class="h-52 w-full object-cover" /><div class="p-7"><div class="flex justify-between gap-4 text-xs text-muted"><span>{post.data.category}</span><span dir="ltr">0{index + 2}</span></div><h3 class="mt-6 font-heading text-2xl font-bold">{post.data.title}</h3><p class="mt-4 text-sm leading-8 text-muted">{post.data.description}</p><div class="mt-8 flex items-center justify-between text-sm"><span class="text-muted">{post.data.readingTime}</span><a href={`/blog/${post.id}`} class="font-bold text-moss">اقرأ ←</a></div></div></article>)}</div></div></section>

  <section class="bg-coral text-white"><div class="container flex flex-col justify-between gap-6 py-14 sm:flex-row sm:items-center"><div><p class="text-sm font-bold text-white/75">لديك فكرة أو تجربة؟</p><h2 class="mt-2 font-heading text-3xl font-bold">ساهم في إثراء الويب العربي.</h2></div><a href="/terms" class="rounded-xl bg-[#102a2b] px-7 py-3.5 font-bold">دليل المساهمة</a></div></section>
</BaseLayout>
