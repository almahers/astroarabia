---
import BaseLayout from '@layouts/BaseLayout.astro';

const sections = [
  { id: 'quick-start', number: '01', label: 'البداية السريعة' },
  { id: 'rtl-system', number: '02', label: 'نظام RTL' },
  { id: 'visual-system', number: '03', label: 'الألوان والخطوط' },
  { id: 'stack', number: '04', label: 'المكتبات والأدوات' },
  { id: 'new-preset', number: '05', label: 'بناء نموذج جديد' },
  { id: 'license', number: '06', label: 'الرخصة' },
  { id: 'faq', number: '07', label: 'أسئلة شائعة' },
];

const principles = [
  {
    title: 'اقرأ أقل، أنجز أكثر',
    text: 'المعلومة بجانب الكود اللي تحتاجه، بدون صفحات نظرية طويلة.',
  },
  { title: 'العربية هي الأصل', text: 'التصميم يبدأ من RTL، مع عناية بالأرقام والأكواد والروابط.' },
  { title: 'ابنِ وشارك', text: 'كل مثال قريب من الاستخدام الفعلي وتقدر تنقله لمشروعك مباشرة.' },
];
---

<BaseLayout
  title="توثيق AstroArabia | ابدأ البناء بثقة"
  description="توثيق عملي لبناء مواقع عربية سريعة باستخدام Astro وTailwind CSS."
>
  <section class="hero-glow soft-grid border-b border-line">
    <div class="container grid items-center gap-12 py-16 sm:py-24 lg:grid-cols-[1.15fr_.85fr]">
      <div>
        <p class="eyebrow">توثيق AstroArabia</p><h1
          class="mt-5 max-w-3xl font-heading text-4xl font-bold leading-[1.65] sm:text-6xl"
        >
          ابنِ بثقة،<br /><span class="text-moss">من أول سطر.</span>
        </h1><p class="mt-7 max-w-2xl text-lg leading-9 text-muted">
          دليل عملي للمطور العربي: شغّل القالب، افهم نظام RTL، وأضف نموذجك الخاص بدون أن تضيع في
          التفاصيل.
        </p><div class="mt-9 flex flex-wrap gap-3">
          <a
            href="#quick-start"
            class="rounded-xl bg-moss px-6 py-3.5 font-bold text-white transition hover:bg-moss-dark"
            >ابدأ خلال دقيقتين</a
          ><a
            href="#new-preset"
            class="rounded-xl border border-line bg-white px-6 py-3.5 font-bold text-moss transition hover:border-moss"
            >خريطة البناء</a
          >
        </div><div class="mt-9 flex gap-6 text-sm text-muted">
          <span><strong class="text-ink">Astro 7</strong> حديث</span><span
            ><strong class="text-ink">Tailwind 4</strong> سريع</span
          ><span><strong class="text-ink">RTL</strong> أصلي</span>
        </div>
      </div><div
        class="overflow-hidden rounded-3xl border border-[#21453e] bg-[#102a2b] shadow-2xl shadow-moss/15"
      >
        <div
          class="flex items-center justify-between border-b border-white/10 px-5 py-4 text-xs text-white/50"
        >
          <span dir="ltr">astroarabia</span><span class="flex gap-1.5"
            ><i class="h-2.5 w-2.5 rounded-full bg-coral"></i><i
              class="h-2.5 w-2.5 rounded-full bg-emerald-300"></i><i
              class="h-2.5 w-2.5 rounded-full bg-white/30"></i></span
          >
        </div><pre
          class="overflow-x-auto p-6 text-sm leading-8 text-emerald-100"
          dir="ltr"><code>const site = &#123;
  direction: 'rtl',
  language: 'ar',
  framework: 'astro'
&#125;;

// build something clear</code></pre><div
          class="m-5 rounded-xl bg-white/10 p-4 text-sm text-white/75"
        >
          <span class="text-emerald-300">✓</span> جاهز للبناء والنشر
        </div>
      </div>
    </div>
  </section>

  <section class="container py-16">
    <div class="grid gap-4 md:grid-cols-3">
      {
        principles.map((principle, index) => (
          <article class="border-t-2 border-moss bg-white p-6">
            <>
              <span class="text-sm font-bold text-coral" dir="ltr">
                0{index + 1}
              </span>
              <h2 class="mt-5 font-heading text-lg font-bold">{principle.title}</h2>
              <p class="mt-3 text-sm leading-8 text-muted">{principle.text}</p>
            </>
          </article>
        ))
      }
    </div>
  </section>

  <section class="border-y border-line bg-white">
    <div class="container grid gap-12 py-20 lg:grid-cols-[.65fr_1.35fr]">
      <aside class="lg:sticky lg:top-28 lg:h-fit">
        <p class="eyebrow">دليل البناء</p><nav class="mt-5 grid gap-2" aria-label="أقسام التوثيق">
          {
            sections.map((section) => (
              <a
                href={`#${section.id}`}
                class="flex items-center gap-3 rounded-xl border border-transparent px-4 py-3 text-sm font-semibold text-muted transition hover:border-line hover:bg-paper hover:text-moss"
              >
                <span class="text-xs text-coral" dir="ltr">
                  {section.number}
                </span>
                {section.label}
              </a>
            ))
          }
        </nav>
      </aside><div class="space-y-16">
        <article id="quick-start">
          <p class="text-xs font-bold tracking-widest text-coral" dir="ltr">01 / QUICK START</p><h2
            class="mt-4 font-heading text-3xl font-bold"
          >
            شغّل مشروعك في دقائق
          </h2><p class="mt-4 max-w-2xl leading-8 text-muted">
            تحتاج Node.js حديثاً، ثم نفذ الأوامر التالية. سيبدأ خادم التطوير على جهازك مع تحديث
            تلقائي أثناء العمل.
          </p><div class="mt-6 overflow-hidden rounded-2xl bg-[#102a2b]">
            <div class="border-b border-white/10 px-5 py-3 text-xs text-white/50" dir="ltr">
              Terminal
            </div><pre
              class="overflow-x-auto p-5 text-sm leading-8 text-emerald-100"
              dir="ltr"><code>npm install
npm run dev</code></pre>
          </div>
        </article><article id="rtl-system">
          <p class="text-xs font-bold tracking-widest text-coral" dir="ltr">02 / RTL SYSTEM</p><h2
            class="mt-4 font-heading text-3xl font-bold"
          >
            RTL بدون حلول مؤقتة
          </h2><p class="mt-4 max-w-2xl leading-8 text-muted">
            الاتجاه مضبوط على المستند، والتخطيطات تستخدم خصائص منطقية مثل `start` و`end`. الأكواد
            والأرقام التقنية معزولة بصرياً باتجاه LTR.
          </p><div class="mt-6 grid gap-4 sm:grid-cols-2">
            <div class="rounded-2xl bg-paper p-5">
              <p class="text-xs text-muted">قاعدة المستند</p><code
                class="mt-3 block text-sm text-moss"
                dir="ltr">dir="rtl" lang="ar"</code
              >
            </div><div class="rounded-2xl bg-paper p-5">
              <p class="text-xs text-muted">قاعدة الكود</p><code
                class="mt-3 block text-sm text-moss"
                dir="ltr">dir="ltr"</code
              >
            </div>
          </div>
        </article><article id="visual-system">
          <p class="text-xs font-bold tracking-widest text-coral" dir="ltr">03 / VISUAL SYSTEM</p><h2
            class="mt-4 font-heading text-3xl font-bold"
          >
            الهوية البصرية في مكان واحد
          </h2><p class="mt-4 max-w-2xl leading-8 text-muted">
            عدّل ألوان القالب ومسافاته من `src/styles/global.css`. الأسماء المنطقية تجعل تغيير الهوية
            أسهل بدون البحث داخل كل صفحة.
          </p><div class="mt-6 grid gap-3 sm:grid-cols-2">
            <div class="flex items-center gap-3 rounded-2xl border border-line bg-paper p-4"><span class="h-10 w-10 shrink-0 rounded-full bg-[#102a2b]"></span><div><p class="font-bold">Ink · النص الأساسي</p><code class="text-xs text-muted" dir="ltr">#102a2b</code></div></div>
            <div class="flex items-center gap-3 rounded-2xl border border-line bg-paper p-4"><span class="h-10 w-10 shrink-0 rounded-full bg-[#1f6b58]"></span><div><p class="font-bold">Moss · اللون الرئيسي</p><code class="text-xs text-muted" dir="ltr">#1f6b58</code></div></div>
            <div class="flex items-center gap-3 rounded-2xl border border-line bg-paper p-4"><span class="h-10 w-10 shrink-0 rounded-full bg-[#e8795f]"></span><div><p class="font-bold">Coral · لون الإبراز</p><code class="text-xs text-muted" dir="ltr">#e8795f</code></div></div>
            <div class="flex items-center gap-3 rounded-2xl border border-line bg-paper p-4"><span class="h-10 w-10 shrink-0 rounded-full bg-[#f7f8f3]"></span><div><p class="font-bold">Paper · خلفية النهار</p><code class="text-xs text-muted" dir="ltr">#f7f8f3</code></div></div>
          </div><div class="mt-6 grid gap-4 sm:grid-cols-2"><div class="rounded-2xl bg-[#102a2b] p-5 text-white"><p class="text-xs text-white/60">العناوين</p><p class="mt-2 font-heading text-xl font-bold">Alexandria Variable</p><code class="mt-2 block text-xs text-emerald-200" dir="ltr">--font-heading</code></div><div class="rounded-2xl border border-line bg-paper p-5"><p class="text-xs text-muted">النصوص</p><p class="mt-2 text-xl font-bold">IBM Plex Sans Arabic</p><code class="mt-2 block text-xs text-moss" dir="ltr">--font-sans</code></div></div>
        </article><article id="stack">
          <p class="text-xs font-bold tracking-widest text-coral" dir="ltr">04 / STACK</p><h2
            class="mt-4 font-heading text-3xl font-bold"
          >
            المكتبات والأدوات المستخدمة
          </h2><p class="mt-4 max-w-2xl leading-8 text-muted">
            القالب متعمد أن يكون خفيفًا: Astro يولد HTML ثابتًا، وTailwind يبني CSS، والمكونات مكتوبة
            بصيغة Astro بدون إطار JavaScript إضافي.
          </p><div class="mt-6 overflow-hidden rounded-2xl border border-line bg-[#102a2b] p-5"><pre
            class="overflow-x-auto text-sm leading-8 text-emerald-100"
            dir="ltr"><code>astro              7.2.9
tailwindcss        4.x
@tailwindcss/vite  4.x
@astrojs/sitemap   3.7.3
class-variance-authority  0.7.x
clsx               2.x</code></pre></div><div class="mt-6 grid gap-4 sm:grid-cols-2"><div class="rounded-2xl bg-paper p-5"><p class="font-bold">الصور</p><p class="mt-2 text-sm leading-7 text-muted">استخدم `Image` و`Picture` من `astro:assets` للصور المحلية. يتم توليد WebP وAVIF و`srcset` أثناء البناء.</p></div><div class="rounded-2xl bg-paper p-5"><p class="font-bold">التفاعل</p><p class="mt-2 text-sm leading-7 text-muted">نستخدم JavaScript صغيرًا فقط للثيم وحركة صفحة الهبوط. لا يوجد React أو Vue أو Svelte.</p></div></div>
        </article><article id="new-preset">
          <p class="text-xs font-bold tracking-widest text-coral" dir="ltr">05 / NEW PRESET</p><h2
            class="mt-4 font-heading text-3xl font-bold"
          >
            أضف نموذجاً جديداً
          </h2><p class="mt-4 max-w-2xl leading-8 text-muted">
            أنشئ صفحة داخل `src/pages`، أعد استخدام `BaseLayout` و`SiteHeader`، ثم أضفها إلى قائمة
            النماذج بعد اكتمالها.
          </p><div class="mt-6 rounded-2xl border border-line bg-paper p-5">
            <pre
              class="overflow-x-auto text-sm leading-8 text-moss"
              dir="ltr"><code>src/pages/my-preset/index.astro

npm run check
npm test
npm run build</code></pre>
          </div>
        </article><article id="license">
          <p class="text-xs font-bold tracking-widest text-coral" dir="ltr">06 / LICENSE</p><h2
            class="mt-4 font-heading text-3xl font-bold"
          >
            رخصة MIT: استخدم القالب بحرية
          </h2><p class="mt-4 max-w-2xl leading-8 text-muted">
            AstroArabia قالب مفتوح المصدر ومتاح مجانًا تحت رخصة MIT. يمكنك استخدامه وتعديله ونشره
            وبيعه ضمن مشروعك، مع الاحتفاظ بنص الرخصة وحقوق النشر في نسخ الكود أو الأجزاء المقتبسة.
          </p><div class="mt-6 grid gap-4 sm:grid-cols-3"><div class="rounded-2xl bg-paper p-5"><p class="font-bold text-moss">مسموح</p><p class="mt-2 text-sm leading-7 text-muted">الاستخدام، التعديل، الدمج، وإعادة التوزيع.</p></div><div class="rounded-2xl bg-paper p-5"><p class="font-bold text-moss">مطلوب</p><p class="mt-2 text-sm leading-7 text-muted">إبقاء إشعار MIT وحقوق النشر مع نسخ الكود.</p></div><div class="rounded-2xl bg-paper p-5"><p class="font-bold text-moss">تنبيه</p><p class="mt-2 text-sm leading-7 text-muted">البرنامج مقدم كما هو، وتتحمل مسؤولية استخدامه.</p></div></div><a href="/LICENSE.txt" class="mt-6 inline-block font-bold text-moss underline decoration-coral decoration-2 underline-offset-8" dir="ltr">Read the full MIT License →</a>
        </article><article id="faq">
          <p class="text-xs font-bold tracking-widest text-coral" dir="ltr">07 / FAQ</p><h2
            class="mt-4 font-heading text-3xl font-bold"
          >
            أسئلة قبل الإطلاق
          </h2><div class="mt-6 divide-y divide-line border-y border-line">
            {
              [
                [
                  'هل القالب Static؟',
                  'نعم، الإخراج الحالي ثابت ومناسب للنشر السريع على Cloudflare Pages أو GitHub Pages.',
                ],
                [
                  'هل نموذج التواصل مربوط بخدمة؟',
                  'لا. النموذج واجهة جاهزة للتخصيص، واختر أنت طريقة الإرسال المناسبة مثل Cloudflare Workers أو Formspree أو API خاص بك.',
                ],
                ['هل يدعم الوضع الليلي؟', 'نعم، الهيدر موحد والوضع يحفظ اختيار المستخدم محلياً.'],
                [
                  'كيف أضيف SEO؟',
                  'يمرر كل Layout عنواناً ووصفاً ويولد canonical وOpen Graph وSitemap تلقائياً.',
                ],
              ].map(([question, answer]) => (
                <details class="group py-5">
                  <>
                    <summary class="flex cursor-pointer list-none justify-between gap-4 font-bold">
                      <>
                        <span>{question}</span>
                        <span class="text-xl text-moss transition group-open:rotate-45">+</span>
                      </>
                    </summary>
                    <p class="mt-3 text-sm leading-8 text-muted">{answer}</p>
                  </>
                </details>
              ))
            }
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="bg-moss text-white">
    <div class="container flex flex-col justify-between gap-7 py-14 sm:flex-row sm:items-center">
      <div>
        <p class="text-sm font-bold text-white/70">لديك تحسين؟</p><h2
          class="mt-2 font-heading text-3xl font-bold"
        >
          ساهم في جعل الويب العربي أفضل.
        </h2>
      </div><a
        href="/docs#new-preset"
        class="rounded-xl bg-coral px-7 py-3.5 font-bold transition hover:bg-[#cf604b]"
        >خطوات التخصيص</a
      >
    </div>
  </section>
</BaseLayout>
