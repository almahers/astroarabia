---
import BaseLayout from '@layouts/BaseLayout.astro';
import DemoCard from '@components/DemoCard.astro';
import Button from '@components/ui/Button.astro';
import Card from '@components/ui/Card.astro';
import { Picture } from 'astro:assets';
import workspaceImage from '../assets/workspace.jpg';

const features = [
  { title: 'سرعة من أول يوم', text: 'Astro وTailwind يعطونك موقع خفيف وجاهز للإنتاج بدون تعقيد.' },
  { title: 'عربي على أصوله', text: 'RTL مضبوط من البداية، حتى التفاصيل الصغيرة والأكواد التقنية.' },
  { title: 'صفر حمل زائد', text: 'HTML ثابت وتجربة سريعة للزائر على الجوال والكمبيوتر.' },
  { title: 'مبني للمجتمع', text: 'مكونات واضحة تقدر تعدلها وتشارك تحسيناتها مع المجتمع بسهولة.' },
];

const demos = [
  {
    title: 'الشركات والخدمات',
    description: 'اعرض خدماتك بوضوح وخذ طلبات العملاء بدون لف ودوران.',
    badge: 'متاح الآن',
    link: '/agency',
    tone: 'text-emerald-700',
  },
  {
    title: 'المنتجات الرقمية',
    description: 'باقات مفهومة تساعد عميلك يختار بسرعة وبثقة.',
    badge: 'متاح الآن',
    link: '/saas',
    tone: 'text-cyan-700',
  },
  {
    title: 'التوثيق والبرمجة',
    description: 'توثيق عربي مرتب يخلي فريقك يبدأ ويكمل بسهولة.',
    badge: 'متاح الآن',
    link: '/docs',
    tone: 'text-sky-700',
  },
  {
    title: 'العلامة الشخصية',
    description: 'اعرض خبرتك وشغلك بطريقة تفتح حوار مهني حقيقي.',
    badge: 'متاح الآن',
    link: '/portfolio',
    tone: 'text-amber-700',
  },
  {
    title: 'صفحة الهبوط',
    description: 'صفحة مركزة لحملتك تخلي الزيارة خطوة واضحة.',
    badge: 'متاح الآن',
    link: '/landing',
    tone: 'text-rose-700',
  },
];
---

<BaseLayout title="AstroArabia | قالب عربي لـ Astro وTailwind">
  <div class="min-h-screen overflow-hidden bg-paper text-ink">
    <section class="hero-glow soft-grid border-b border-line">
      <div class="container grid items-center gap-12 py-20 sm:py-28 lg:grid-cols-[1.05fr_.95fr]">
        <div>
          <p class="eyebrow">قالب مفتوح للمجتمع التقني السعودي</p><h1
            class="mt-5 max-w-3xl font-heading text-4xl font-bold leading-[1.55] sm:text-6xl"
          >
            اطلق موقعك العربي<br /><span class="text-moss">بسرعة وبدون تعقيد.</span>
          </h1><p class="mt-7 max-w-xl text-lg leading-9 text-muted">
            AstroArabia يعطيك نقطة بداية عملية للشركات والمنتجات والمشاريع الشخصية، بأداء سريع وبنية
            واضحة تقدر تكبر معها.
          </p><div class="mt-9 flex flex-wrap items-center gap-4">
            <a
              href="#demos"
              class="rounded-xl bg-moss px-7 py-3.5 font-bold text-white shadow-lg shadow-moss/20 transition hover:bg-moss-dark"
              >شوف القوالب</a
            ><a
              href="https://github.com/example/astroarabia"
              class="font-bold text-moss underline decoration-coral decoration-2 underline-offset-8"
              dir="ltr">GitHub →</a
            >
          </div>
        </div><div class="relative">
          <div
            class="overflow-hidden rounded-3xl border border-white bg-white shadow-2xl shadow-moss/15"
          >
            <Picture
              src={workspaceImage}
              formats={['avif', 'webp']}
              widths={[640, 960, 1280, 1600]}
              alt="مساحة عمل لتصميم واجهة رقمية"
              class="h-80 w-full object-cover sm:h-[27rem]"
              sizes="(min-width: 1024px) 50vw, 100vw"
            /><div class="grid grid-cols-2 gap-3 bg-white p-4">
              <div class="rounded-xl bg-paper p-4">
                <p class="text-xs text-muted">اللغة</p><p class="mt-1 font-bold">العربية أولاً</p>
              </div><div class="rounded-xl bg-moss p-4 text-white">
                <p class="text-xs text-white/70">الاتجاه</p><p class="mt-1 font-bold" dir="ltr">
                  RTL / LTR
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
    <section class="border-b border-line bg-white py-8 dark:bg-[#102a2b]">
      <div class="container">
        <p class="mb-7 text-center text-sm font-bold text-moss dark:text-emerald-300">
          أسرع قالب مجاني عربي 100%
        </p>
        <ul class="grid grid-cols-2 gap-y-8 sm:grid-cols-5" aria-label="Technical quality scores">
          <li class="flex flex-col items-center text-center" dir="ltr">
            <span
              class="grid h-16 w-16 place-items-center rounded-full border-2 border-green-500 text-xl font-bold text-green-600"
              >100</span
            >
            <span class="mt-2 text-xs font-semibold text-gray-700 dark:text-gray-300"
              >Performance</span
            >
          </li>
          <li class="flex flex-col items-center text-center" dir="ltr">
            <span
              class="grid h-16 w-16 place-items-center rounded-full border-2 border-green-500 text-xl font-bold text-green-600"
              >100</span
            >
            <span class="mt-2 text-xs font-semibold text-gray-700 dark:text-gray-300"
              >Accessibility</span
            >
          </li>
          <li class="flex flex-col items-center text-center" dir="ltr">
            <span
              class="grid h-16 w-16 place-items-center rounded-full border-2 border-green-500 text-xl font-bold text-green-600"
              >100</span
            >
            <span class="mt-2 text-xs font-semibold text-gray-700 dark:text-gray-300"
              >Best Practices</span
            >
          </li>
          <li class="flex flex-col items-center text-center" dir="ltr">
            <span
              class="grid h-16 w-16 place-items-center rounded-full border-2 border-green-500 text-xl font-bold text-green-600"
              >100</span
            >
            <span class="mt-2 text-xs font-semibold text-gray-700 dark:text-gray-300">SEO</span>
          </li>
          <li class="col-span-2 flex items-center justify-center sm:col-span-1" dir="ltr">
            <span
              class="inline-flex items-center gap-2 rounded-full bg-green-50 px-3 py-2 text-xs font-bold text-green-700 dark:bg-green-500/10 dark:text-green-400"
              ><span class="h-2 w-2 rounded-full bg-green-500"></span>3/3 Agentic Browsing</span
            >
          </li>
        </ul>
      </div>
    </section>
    <section class="border-b border-line bg-paper">
      <div class="container grid gap-5 py-10 sm:grid-cols-[.8fr_1.2fr] sm:items-center">
        <div>
          <p class="eyebrow">لماذا السرعة؟</p><h2 class="mt-3 font-heading text-2xl font-bold">
            أساس خفيف يترك مساحة لمحتواك.
          </h2>
        </div><p class="max-w-2xl text-sm leading-8 text-muted">
          نبدأ بصفحات Static، ونحمّل JavaScript عند الحاجة فقط، ونحسّن الصور أثناء البناء. النتيجة
          بداية سريعة وقابلة للتوسع، بينما الدرجة النهائية تتأثر بالمحتوى والاستضافة التي تختارها.
        </p>
      </div>
    </section>
    <section id="features" class="container py-20 sm:py-28">
      <div class="mx-auto max-w-2xl text-center">
        <p class="eyebrow">ليش AstroArabia؟</p><h2
          class="mt-4 font-heading text-3xl font-bold sm:text-4xl"
        >
          أساس تقني يخليك تنجز أسرع.
        </h2><p class="mt-5 text-muted">
          كل اللي تحتاجه للنسخة الأولى، مع مساحة كاملة لهوية مشروعك.
        </p>
      </div><div class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          features.map((feature, index) => (
            <Card interactive class="border-t-2 border-moss p-6">
              <>
                <span class="text-sm font-bold text-coral" dir="ltr">
                  0{index + 1}
                </span>
                <h3 class="mt-5 font-heading text-lg font-bold">{feature.title}</h3>
                <p class="mt-3 text-sm leading-7 text-muted">{feature.text}</p>
              </>
            </Card>
          ))
        }
      </div>
    </section>
    <section id="start" class="border-y border-line bg-white">
      <div class="container grid gap-12 py-20 lg:grid-cols-[.7fr_1.3fr]">
        <div>
          <p class="eyebrow">طريقة العمل</p><h2 class="mt-4 font-heading text-3xl font-bold">
            من الفكرة إلى الإطلاق بثلاث خطوات واضحة.
          </h2>
        </div><div class="grid gap-8 sm:grid-cols-3">
          {
            ['شغّل القالب', 'أضف محتواك', 'شارك إطلاقك'].map((step, index) => (
              <div>
                <>
                  <span
                    class="grid h-10 w-10 place-items-center rounded-full bg-moss font-bold text-white"
                    dir="ltr"
                  >
                    {index + 1}
                  </span>
                  <h3 class="mt-4 font-bold">{step}</h3>
                  <p class="mt-2 text-sm leading-7 text-muted">
                    خطوات قصيرة تخليك تطلع بنسخة أولى مرتبة بدون ما تضيع وقتك.
                  </p>
                </>
              </div>
            ))
          }
        </div>
      </div>
    </section>
    <section id="demos" class="container py-section">
      <div
        class="flex flex-col justify-between gap-content border-b border-line pb-8 sm:flex-row sm:items-end"
      >
        <div>
          <p class="eyebrow">قوالب جاهزة للتجربة</p><h2
            class="mt-4 font-heading text-3xl font-bold"
          >
            خذ البداية اللي تناسب مشروعك.
          </h2>
        </div><p class="max-w-md text-sm leading-7 text-muted">
          خمسة مسارات عملية للفرق والمطورين، وكل واحد منها جاهز للتعديل والنشر.
        </p>
      </div><div class="mt-8 grid grid-cols-1 gap-content sm:grid-cols-2 lg:grid-cols-3">
        {demos.map((demo, index) => <DemoCard {...demo} index={index} />)}
      </div>
    </section>
    <section class="bg-moss text-white">
      <div class="container flex flex-col justify-between gap-7 py-14 sm:flex-row sm:items-center">
        <div>
          <p class="text-sm font-bold text-white/70">جاهز تطلع فكرتك للنور؟</p><h2
            class="mt-2 font-heading text-3xl font-bold"
          >
            خل مشروعك العربي يبدأ بشكل أقوى.
          </h2>
        </div><Button href="/agency" icon="↗">ابدأ مشروعك</Button>
      </div>
    </section>
  </div>
</BaseLayout>
