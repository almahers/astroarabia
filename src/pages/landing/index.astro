---
import BaseLayout from '@layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import launchTeamImage from '../../assets/launch-team.jpg';
import workspaceImage from '../../assets/workspace.jpg';

const promise = [
  ['رسالة واحدة', 'كل كلمة وقرار بصري يخدم هدف الحملة.'],
  ['ثقة أسرع', 'دليل اجتماعي ومعلومات مرتبة قبل طلب الإجراء.'],
  ['خطوة واضحة', 'مسار قصير يقود الزائر دون تشتيت.'],
];

const deliverables = ['تحديد العرض والجمهور', 'كتابة هيكل الصفحة ورسائلها', 'تصميم RTL متجاوب', 'تهيئة SEO والأداء', 'تجهيز القياس والتحسين'];
const faqs = [
  ['هل تصلح الصفحة للحملات المدفوعة؟', 'نعم. بنيت الصفحة حول رسالة واحدة ومسار قصير يناسب الزيارات القادمة من الإعلانات.'],
  ['هل أستطيع تعديلها لاحقًا؟', 'نعم. المكونات واضحة والمحتوى قابل للتعديل، ويمكنك ربط النموذج أو الدفع بالطريقة التي تناسبك.'],
  ['ما الذي أحتاجه للبدء؟', 'عرض واضح، جمهور محدد، وهدف واحد تريد من الصفحة تحقيقه. الباقي نرتبه داخل القالب.'],
];
---

<BaseLayout title="صفحة هبوط عالية التحويل | AstroArabia" description="صفحة هبوط عربية سريعة ومصممة لتحويل الزيارات إلى فرص واضحة." variant="dark">
  <div class="landing-page">
    <section class="landing-section relative overflow-hidden border-b border-white/10" data-reveal>
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_20%_20%,rgba(232,121,95,.18),transparent_34rem)]"></div>
      <div class="container relative grid items-center gap-14 py-20 sm:py-28 lg:grid-cols-[1.1fr_.9fr]">
        <div>
          <p class="text-sm font-bold text-emerald-300">نظام إطلاق للمنتجات والخدمات</p>
          <h1 class="mt-6 max-w-4xl font-heading text-4xl font-bold leading-[1.55] sm:text-6xl">حوّل الاهتمام<br /><span class="text-coral">إلى خطوة محسوبة.</span></h1>
          <p class="mt-7 max-w-xl text-lg leading-9 text-white/70">صفحة هبوط عربية لا تكتفي بأن تبدو جميلة. ترتب عرضك، تبني الثقة، وتوصل الزائر إلى الإجراء الذي يهمك.</p>
          <div class="mt-9 flex flex-col gap-4 sm:flex-row"><a href="#offer" class="rounded-xl bg-coral px-8 py-4 text-center font-bold text-white shadow-xl shadow-black/20 transition hover:bg-[#cf604b]">شاهد الباقة</a><a href="#story" class="rounded-xl border border-white/20 px-8 py-4 text-center font-bold text-white/80 transition hover:border-white hover:text-white">لماذا تنجح؟</a></div>
          <div class="mt-10 flex flex-wrap gap-x-8 gap-y-3 border-t border-white/10 pt-6 text-sm text-white/55"><span><strong class="text-white">01</strong> هدف واضح</span><span><strong class="text-white">02</strong> رسالة مركزة</span><span><strong class="text-white">03</strong> إجراء قابل للقياس</span></div>
        </div>
        <div id="offer" class="relative rounded-3xl bg-white p-7 text-ink shadow-2xl shadow-black/30 sm:p-9"><div class="flex items-start justify-between gap-4"><div><p class="text-sm font-bold text-moss">باقة الإطلاق</p><h2 class="mt-2 font-heading text-2xl font-bold">صفحة تحول الزائر</h2></div><span class="rounded-full bg-coral/10 px-3 py-1 text-xs font-bold text-coral">مركزة</span></div><div class="mt-7 border-b border-line pb-7"><span class="font-heading text-6xl font-bold" dir="ltr">899</span><span class="ms-2 text-sm text-muted">ريال مرة واحدة</span></div><ul class="mt-7 space-y-4 text-sm font-semibold">{['تحليل العرض والجمهور', 'تصميم RTL متجاوب', 'نموذج جمع عملاء', 'تهيئة SEO والأداء'].map((item) => <li class="flex items-center gap-3"><span class="grid h-6 w-6 place-items-center rounded-full bg-moss/10 text-moss">✓</span>{item}</li>)}</ul><a href="/agency#quote" class="mt-8 block rounded-xl bg-moss px-5 py-4 text-center font-bold text-white transition hover:bg-moss-dark">ابدأ طلبك الآن</a><p class="mt-4 text-center text-xs text-muted">تخصيص وربط الخدمات متروك لك.</p></div>
      </div>
    </section>

    <section class="landing-section bg-[#0b211e]" data-reveal><div class="container grid gap-8 py-14 md:grid-cols-3">{promise.map(([title, text], index) => <article class="border-s-2 border-coral/70 ps-6"><span class="text-sm font-bold text-coral" dir="ltr">0{index + 1}</span><h2 class="mt-4 font-heading text-xl font-bold">{title}</h2><p class="mt-3 text-sm leading-8 text-white/60">{text}</p></article>)}</div></section>

    <section id="story" class="landing-section bg-white py-20 text-ink sm:py-28" data-reveal><div class="container grid items-center gap-12 lg:grid-cols-[.8fr_1.2fr]"><div><p class="text-sm font-bold text-moss">الفكرة وراء الصفحة</p><h2 class="mt-4 max-w-2xl font-heading text-3xl font-bold sm:text-5xl">الزائر لا يحتاج معلومات أكثر. يحتاج قرارًا أسهل.</h2><p class="mt-6 max-w-xl text-lg leading-9 text-muted">نرتب الصفحة مثل حوار جيد: نبدأ بالمشكلة، نثبت أن الحل مناسب، ثم نطلب خطوة واحدة فقط.</p><div class="mt-9 grid gap-4 sm:grid-cols-2"><div class="border-s-2 border-moss ps-4"><p class="font-bold">وضوح أعلى</p><p class="mt-1 text-sm leading-7 text-muted">رسالة يفهمها الزائر بسرعة.</p></div><div class="border-s-2 border-coral ps-4"><p class="font-bold">احتكاك أقل</p><p class="mt-1 text-sm leading-7 text-muted">أزرار وأقسام تخدم المسار.</p></div></div></div><div class="overflow-hidden rounded-3xl"><Image src={workspaceImage} alt="فريق يخطط لحملة إطلاق رقمية" width={1600} height={1000} layout="constrained" sizes="(min-width: 1024px) 55vw, 100vw" class="h-80 w-full object-cover sm:h-[30rem]" /></div></div></section>

    <section class="landing-section border-y border-line bg-paper py-20 text-ink sm:py-28" data-reveal><div class="container grid gap-12 lg:grid-cols-[.7fr_1.3fr]"><div><p class="text-sm font-bold text-moss">ماذا تستلم؟</p><h2 class="mt-4 font-heading text-3xl font-bold sm:text-4xl">كل ما تحتاجه قبل زر النشر.</h2><p class="mt-5 leading-8 text-muted">الهدف ليس صفحة طويلة. الهدف صفحة تعرف بالضبط ماذا تقول ومتى تقولها.</p></div><div class="grid gap-3 sm:grid-cols-2">{deliverables.map((item, index) => <div class="flex items-center gap-4 border-b border-line py-5"><span class="text-sm font-bold text-coral" dir="ltr">0{index + 1}</span><span class="font-bold">{item}</span></div>)}</div></div></section>

    <section class="landing-section bg-white py-20 text-ink sm:py-28" data-reveal><div class="container grid items-center gap-12 lg:grid-cols-[1.05fr_.95fr]"><div class="overflow-hidden rounded-3xl"><Image src={launchTeamImage} alt="فريق يراجع نتائج إطلاق منتج" width={1400} height={933} layout="constrained" sizes="(min-width: 1024px) 50vw, 100vw" class="h-80 w-full object-cover sm:h-[28rem]" /></div><div><p class="text-sm font-bold text-moss">صممت لتتحسن</p><h2 class="mt-4 font-heading text-3xl font-bold sm:text-4xl">أطلق النسخة الأولى، ثم دع البيانات تتكلم.</h2><p class="mt-6 leading-9 text-muted">البنية الخفيفة تجعل تعديل الرسالة والأقسام سريعًا. أضف التحليلات التي تختارها، اختبر، وحسّن ما يهم.</p><a href="/docs" class="mt-8 inline-block font-bold text-moss underline decoration-coral decoration-2 underline-offset-8">اقرأ طريقة البناء ←</a></div></div></section>

    <section class="landing-section bg-paper py-20 text-ink sm:py-28" data-reveal><div class="container grid gap-12 lg:grid-cols-[.75fr_1.25fr]"><div><p class="text-sm font-bold text-moss">أسئلة قبل الإطلاق</p><h2 class="mt-4 font-heading text-3xl font-bold sm:text-4xl">كل شيء واضح قبل أن تبدأ.</h2></div><div class="divide-y divide-line border-y border-line">{faqs.map(([question, answer]) => <details class="group py-5"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-bold"><span>{question}</span><span class="text-xl text-moss transition group-open:rotate-45">+</span></summary><p class="mt-3 max-w-2xl text-sm leading-8 text-muted">{answer}</p></details>)}</div></div></section>

    <section class="landing-section bg-coral" data-reveal><div class="container flex flex-col justify-between gap-7 py-16 sm:flex-row sm:items-center"><div><p class="text-sm font-bold text-white/75">الخطوة التالية بسيطة</p><h2 class="mt-2 font-heading text-3xl font-bold text-white sm:text-4xl">اجعل عرضك يستحق النقر.</h2></div><a href="/agency#quote" class="rounded-xl bg-[#102a2b] px-8 py-4 text-center font-bold text-white transition hover:bg-[#071312]">ابدأ الآن</a></div></section>
  </div>
</BaseLayout>

<style>
  .landing-section {
    opacity: 0.42;
    filter: blur(3px);
    transform: translateY(2rem);
    transition: opacity 0.7s ease, filter 0.7s ease, transform 0.7s ease;
  }
  .landing-section.is-visible {
    opacity: 1;
    filter: blur(0);
    transform: translateY(0);
  }
  .landing-section.is-past {
    opacity: 0.58;
    filter: blur(2px);
    transform: translateY(-0.5rem);
  }
  @media (prefers-reduced-motion: reduce) {
    .landing-section,
    .landing-section.is-visible,
    .landing-section.is-past {
      opacity: 1;
      filter: none;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  const sections = document.querySelectorAll<HTMLElement>('.landing-section');
  const updateSections = () => {
    const activationLine = window.innerHeight * 0.84;
    sections.forEach((section) => {
      const bounds = section.getBoundingClientRect();
      const isPast = bounds.bottom < 80;
      const isVisible = bounds.top < activationLine && !isPast;
      section.classList.toggle('is-past', isPast);
      section.classList.toggle('is-visible', isVisible);
    });
  };
  updateSections();
  window.addEventListener('scroll', updateSections, { passive: true });
</script>
