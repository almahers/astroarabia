---
import BaseLayout from '@layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import nucleusProjectImage from '../../assets/nucleus-project.jpg';
import madarStudioImage from '../../assets/madar-studio.jpg';
import launchTeamImage from '../../assets/launch-team.jpg';

const projects = [
  {
    number: '01',
    title: 'منصة نواة',
    type: 'استراتيجية رقمية',
    year: '2026',
    description: 'إعادة ترتيب تجربة منصة خدمات لتصبح الرسالة أوضح ومسار التواصل أقصر.',
    image: nucleusProjectImage,
    size: 'md:col-span-7',
  },
  {
    number: '02',
    title: 'استوديو مدار',
    type: 'هوية وتجربة',
    year: '2025',
    description: 'واجهة هادئة لاستوديو إبداعي تعرض طريقة العمل قبل التفاصيل.',
    image: madarStudioImage,
    size: 'md:col-span-5',
  },
  {
    number: '03',
    title: 'أثر للاستشارات',
    type: 'منتج رقمي',
    year: '2024',
    description: 'صفحة منتج تساعد الزائر على فهم القيمة واتخاذ الخطوة التالية.',
    image: launchTeamImage,
    size: 'md:col-span-5',
  },
];

const capabilities = ['الاستراتيجية والرسائل', 'تجربة المستخدم وواجهات الويب', 'أنظمة التصميم العربية', 'تطوير Astro وواجهات Static'];
---

<BaseLayout
  title="الأعمال والمشاريع | AstroArabia"
  description="معرض أعمال عربي يعرض مشاريع في الاستراتيجية الرقمية وتجربة المستخدم وتطوير الويب."
>
  <section class="border-b border-line bg-[#102a2b] text-white">
    <div class="container grid items-end gap-12 py-20 sm:py-28 lg:grid-cols-[1.15fr_.85fr]">
      <div>
        <p class="text-sm font-bold text-emerald-300">أعمال مختارة · 2024 — 2026</p>
        <h1 class="mt-5 max-w-4xl font-heading text-4xl font-bold leading-[1.55] sm:text-6xl">
          أفكار واضحة،<br /><span class="text-coral">تجارب تبقى.</span>
        </h1>
        <p class="mt-7 max-w-2xl text-lg leading-9 text-white/70">
          أساعد الفرق وأصحاب المشاريع على تحويل الأفكار المعقدة إلى حضور رقمي مفهوم، جميل، وقابل للاستخدام.
        </p>
        <a href="#projects" class="mt-9 inline-block rounded-xl bg-coral px-7 py-3.5 font-bold text-white transition hover:bg-[#cf604b]">شاهد المشاريع</a>
      </div>
      <div class="border-s-2 border-coral ps-6"><p class="text-5xl font-heading font-bold text-white">12</p><p class="mt-2 text-white/60">مشروعًا بُني حول سؤال واحد:<br />كيف نجعل القرار أسهل؟</p></div>
    </div>
  </section>

  <section class="border-b border-line bg-paper">
    <div class="container grid gap-8 py-12 sm:grid-cols-3">
      <div><p class="text-sm text-muted">مجال العمل</p><p class="mt-2 font-heading text-xl font-bold">استراتيجية رقمية</p></div>
      <div class="border-s border-line ps-8"><p class="text-sm text-muted">طريقة البناء</p><p class="mt-2 font-heading text-xl font-bold">عربي · RTL · Static</p></div>
      <div class="border-s border-line ps-8"><p class="text-sm text-muted">التركيز</p><p class="mt-2 font-heading text-xl font-bold">وضوح قبل الزخرفة</p></div>
    </div>
  </section>

  <section id="projects" class="container py-20 sm:py-28">
    <div class="flex flex-col justify-between gap-6 border-b border-line pb-8 sm:flex-row sm:items-end"><div><p class="eyebrow">مختارات من الأعمال</p><h2 class="mt-4 font-heading text-3xl font-bold sm:text-4xl">المشروع الجيد يشرح نفسه.</h2></div><p class="max-w-sm text-sm leading-7 text-muted">مجموعة من التجارب التي بدأت من احتياج واضح وانتهت بواجهة تخدم الهدف.</p></div>
    <div class="mt-12 grid gap-6 md:grid-cols-12">
      {projects.map((project) => <article class={`group ${project.size}`}>
        <div class="relative overflow-hidden rounded-3xl bg-[#102a2b]">
          <Image src={project.image} alt={`صورة مشروع ${project.title}`} loading="lazy" width={1400} height={933} layout="constrained" sizes="(min-width: 768px) 58vw, 100vw" class="h-72 w-full object-cover transition duration-500 group-hover:scale-105 sm:h-96" />
          <div class="absolute inset-0 bg-gradient-to-t from-[#102a2b]/90 via-transparent to-transparent"></div>
          <div class="absolute inset-x-0 bottom-0 flex items-end justify-between gap-4 p-6 text-white sm:p-8"><div><p class="text-sm text-white/65">{project.type} · {project.year}</p><h3 class="mt-2 font-heading text-2xl font-bold sm:text-3xl">{project.title}</h3></div><span class="text-sm font-bold text-coral" dir="ltr">{project.number}</span></div>
        </div>
        <p class="mt-4 max-w-xl text-sm leading-8 text-muted">{project.description}</p>
      </article>)}
    </div>
  </section>
  <section class="border-y border-line bg-white">
    <div class="container grid gap-12 py-20 sm:py-28 lg:grid-cols-[.75fr_1.25fr]">
      <div><p class="eyebrow">ما أقدمه</p><h2 class="mt-4 font-heading text-3xl font-bold sm:text-4xl">نبدأ من المعنى، ثم نصنع الشكل.</h2><p class="mt-5 leading-8 text-muted">كل مشروع يحتاج قرارات مختلفة، لكن النتيجة دائمًا تجربة يفهمها الناس ويستطيعون استخدامها.</p></div>
      <div class="grid gap-4 sm:grid-cols-2">{capabilities.map((capability, index) => <div class="flex items-center gap-4 border-b border-line py-5"><span class="text-sm font-bold text-coral" dir="ltr">0{index + 1}</span><span class="font-bold">{capability}</span></div>)}</div>
    </div>
  </section>

  <section class="bg-paper">
    <div class="container grid items-center gap-12 py-20 sm:py-28 lg:grid-cols-[1fr_1fr]">
      <div class="overflow-hidden rounded-3xl"><Image src={launchTeamImage} alt="فريق يناقش تجربة رقمية" width={1400} height={933} layout="constrained" sizes="(min-width: 1024px) 50vw, 100vw" class="h-80 w-full object-cover sm:h-[28rem]" /></div>
      <div><p class="eyebrow">طريقة التفكير</p><h2 class="mt-4 font-heading text-3xl font-bold sm:text-4xl">التصميم ليس ما نضيفه. بل ما نوضحه.</h2><p class="mt-6 leading-9 text-muted">أبحث عن النقطة التي يتعثر عندها الزائر، ثم أبني حولها لغة وهيكلًا وتجربة تجعل الخطوة التالية طبيعية.</p><a href="#contact" class="mt-8 inline-block font-bold text-moss underline decoration-coral decoration-2 underline-offset-8">لنتحدث عن مشروعك ←</a></div>
    </div>
  </section>

  <section id="contact" class="bg-[#102a2b] text-white"><div class="container flex flex-col justify-between gap-8 py-16 sm:flex-row sm:items-center"><div><p class="text-sm font-bold text-emerald-300">هل لديك تحدٍ واضح؟</p><h2 class="mt-3 font-heading text-3xl font-bold sm:text-4xl">لنحوّل الفكرة إلى تجربة تستحق العرض.</h2></div><a href="mailto:hello@astroarabia.dev" dir="ltr" class="rounded-xl bg-coral px-7 py-3.5 text-center font-bold transition hover:bg-[#cf604b]">hello@astroarabia.dev</a></div></section>
</BaseLayout>
