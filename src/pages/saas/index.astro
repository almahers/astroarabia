---
import BaseLayout from '@layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import saasTeamImage from '../../assets/saas-team.jpg';
import launchTeamImage from '../../assets/launch-team.jpg';

const products = [
  {
    category: 'قوالب جاهزة',
    name: 'حزمة الإطلاق',
    description: 'كل ما تحتاجه لتبدأ حضورك الرقمي بشكل مرتب وسريع.',
    price: '149',
    accent: 'border-moss',
    featured: true,
  },
  {
    category: 'أدوات العمل',
    name: 'نظام المحتوى',
    description: 'ملفات وقوالب تساعد فريقك على تنظيم الرسائل والمحتوى.',
    price: '79',
    accent: 'border-coral',
  },
  {
    category: 'تعلم وتطوير',
    name: 'دليل البداية',
    description: 'مسار عملي لبناء مشروع رقمي واضح من الفكرة إلى النشر.',
    price: '49',
    accent: 'border-emerald-500',
  },
];

const benefits = [
  ['وصول فوري', 'استلم منتجك مباشرة بعد إتمام الطلب.'],
  ['ملفات عربية', 'محتوى مصمم لاحتياجات السوق العربي وRTL.'],
  ['تحديثات مستمرة', 'تحسينات وإصدارات جديدة للمنتج مع الوقت.'],
];

const categories = ['الكل', 'قوالب جاهزة', 'أدوات العمل', 'تعلم وتطوير'];
---

<BaseLayout
  title="متجر المنتجات الرقمية | AstroArabia"
  description="متجر عربي للمنتجات الرقمية والقوالب والأدوات التي تساعدك على بناء حضورك بسرعة."
>
  <section class="border-b border-line bg-[#102a2b] text-white">
    <div class="container grid items-center gap-12 py-20 sm:py-28 lg:grid-cols-[1.1fr_.9fr]">
      <div>
        <p class="text-sm font-bold text-emerald-300">متجر المنتجات الرقمية</p>
        <h1 class="mt-5 max-w-3xl font-heading text-4xl font-bold leading-[1.55] sm:text-6xl">
          أدوات أفضل<br /><span class="text-coral">لعمل رقمي أسرع.</span>
        </h1>
        <p class="mt-7 max-w-xl text-lg leading-9 text-white/70">
          منتجات عملية، قوالب واضحة، وموارد عربية تساعدك على الانتقال من الفكرة إلى نتيجة قابلة للاستخدام.
        </p>
        <div class="mt-9 flex flex-wrap gap-4">
          <a href="#products" class="rounded-xl bg-coral px-7 py-3.5 font-bold text-white transition hover:bg-[#cf604b]">تصفح المنتجات</a>
          <a href="#why-us" class="rounded-xl border border-white/20 px-7 py-3.5 font-bold text-white/80 transition hover:border-white hover:text-white">لماذا متجرنا؟</a>
        </div>
        <div class="mt-12 flex flex-wrap gap-x-8 gap-y-3 border-t border-white/10 pt-6 text-sm text-white/60">
          <span><strong class="text-white">رقمية</strong> · تحميل فوري</span>
          <span><strong class="text-white">عربية</strong> · RTL من الأصل</span>
          <span><strong class="text-white">مرنة</strong> · تعدّلها كما تريد</span>
        </div>
      </div>
      <div class="relative">
        <div class="absolute -inset-4 rounded-[2rem] border border-coral/20"></div>
        <div class="relative overflow-hidden rounded-3xl border border-white/10 bg-white/10 shadow-2xl shadow-black/30">
          <Image src={saasTeamImage} alt="فريق يعمل على تطوير منتج رقمي" width={1400} height={933} layout="constrained" sizes="(min-width: 1024px) 42vw, 100vw" class="h-80 w-full object-cover sm:h-[27rem]" />
          <div class="flex items-center justify-between bg-[#173b38] p-5">
            <div><p class="text-xs text-white/50">الأكثر طلبًا</p><p class="mt-1 font-bold">حزمة الإطلاق</p></div>
            <span class="rounded-full bg-coral px-3 py-1 text-sm font-bold">149 ريال</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="border-b border-line bg-paper">
    <div class="container grid gap-8 py-12 sm:grid-cols-3">
      {benefits.map(([title, description], index) => <div class="flex gap-4 sm:border-s sm:border-line sm:ps-8"><span class="text-sm font-bold text-coral" dir="ltr">0{index + 1}</span><div><h2 class="font-heading text-lg font-bold">{title}</h2><p class="mt-2 text-sm leading-7 text-muted">{description}</p></div></div>)}
    </div>
  </section>

  <section id="products" class="container py-20 sm:py-28">
    <div class="flex flex-col justify-between gap-8 border-b border-line pb-8 md:flex-row md:items-end">
      <div><p class="eyebrow">منتجات مختارة</p><h2 class="mt-4 font-heading text-3xl font-bold sm:text-4xl">شيء مفيد لمشروعك القادم.</h2><p class="mt-5 max-w-xl leading-8 text-muted">اختر المورد المناسب لك، وابدأ باستخدامه مباشرة بدل بناء كل شيء من الصفر.</p></div>
      <nav class="flex flex-wrap gap-2" aria-label="تصنيفات المنتجات">{categories.map((category, index) => <a href={index === 0 ? '#products' : '#products'} class={`rounded-full border px-4 py-2 text-sm font-bold transition ${index === 0 ? 'border-moss bg-moss text-white' : 'border-line text-muted hover:border-moss hover:text-moss'}`}>{category}</a>)}</nav>
    </div>
    <div class="mt-10 grid gap-5 lg:grid-cols-3">
      {products.map((product) => <article class={`relative flex flex-col rounded-2xl border-t-4 ${product.accent} border-x border-b border-line bg-white p-7 shadow-sm transition hover:-translate-y-1 hover:shadow-xl`}>
        {product.featured && <span class="absolute -top-3 end-6 rounded-full bg-coral px-3 py-1 text-xs font-bold text-white">الأكثر اختياراً</span>}
        <p class="text-sm font-bold text-muted">{product.category}</p>
        <h3 class="mt-4 font-heading text-2xl font-bold">{product.name}</h3>
        <p class="mt-3 min-h-14 text-sm leading-7 text-muted">{product.description}</p>
        <div class="mt-8 flex items-end gap-2 border-t border-line pt-6"><span class="font-heading text-4xl font-bold" dir="ltr">{product.price}</span><span class="mb-1 text-sm text-muted">ريال</span></div>
        <ul class="mt-6 space-y-3 text-sm"><li>✓ ملفات قابلة للتعديل</li><li>✓ ترخيص استخدام واضح</li><li>✓ تحديثات المنتج</li></ul>
        <a href="#purchase" class="mt-8 block rounded-xl bg-paper px-5 py-3 text-center font-bold text-moss transition hover:bg-moss hover:text-white">عرض التفاصيل</a>
      </article>)}
    </div>
  </section>

  <section id="why-us" class="border-y border-line bg-white">
    <div class="container grid items-center gap-12 py-20 sm:py-28 lg:grid-cols-[.9fr_1.1fr]">
      <div class="overflow-hidden rounded-3xl"><Image src={launchTeamImage} alt="فريق يراجع تفاصيل منتج رقمي" width={1400} height={933} layout="constrained" sizes="(min-width: 1024px) 45vw, 100vw" class="h-80 w-full object-cover sm:h-[27rem]" /></div>
      <div><p class="eyebrow">اختيار عملي</p><h2 class="mt-4 font-heading text-3xl font-bold sm:text-4xl">لا تشتري ملفًا فقط. اشترِ وقتًا أوفر.</h2><p class="mt-6 max-w-2xl leading-9 text-muted">كل منتج هنا مصمم ليختصر عليك القرارات المتكررة، ويمنحك أساسًا واضحًا تستطيع تطويره بما يناسب مشروعك.</p><div class="mt-8 grid gap-4 sm:grid-cols-2"><div class="border-s-2 border-moss ps-4"><p class="font-bold">مصمم للاستخدام</p><p class="mt-1 text-sm leading-7 text-muted">أمثلة واضحة وملفات مرتبة.</p></div><div class="border-s-2 border-coral ps-4"><p class="font-bold">جاهز للتخصيص</p><p class="mt-1 text-sm leading-7 text-muted">غيّر الألوان والمحتوى بسهولة.</p></div></div></div>
    </div>
  </section>

  <section id="purchase" class="bg-paper">
    <div class="container grid gap-10 py-20 sm:py-28 lg:grid-cols-[.8fr_1.2fr]">
      <div><p class="eyebrow">كيف يعمل المتجر؟</p><h2 class="mt-4 font-heading text-3xl font-bold sm:text-4xl">اختر، حمّل، وابدأ.</h2><p class="mt-5 leading-8 text-muted">هذه واجهة متجر جاهزة. أضف بوابة الدفع أو طريقة التسليم التي تناسبك عند استخدام القالب.</p></div>
      <div class="grid gap-4 sm:grid-cols-3"><article class="border-t-2 border-moss pt-5"><span class="text-sm font-bold text-coral" dir="ltr">01</span><h3 class="mt-3 font-bold">اختر منتجك</h3><p class="mt-2 text-sm leading-7 text-muted">قارن التفاصيل واختر ما يناسب هدفك.</p></article><article class="border-t-2 border-moss pt-5"><span class="text-sm font-bold text-coral" dir="ltr">02</span><h3 class="mt-3 font-bold">أكمل الطلب</h3><p class="mt-2 text-sm leading-7 text-muted">اربط الزر بخدمة الدفع المفضلة لديك.</p></article><article class="border-t-2 border-moss pt-5"><span class="text-sm font-bold text-coral" dir="ltr">03</span><h3 class="mt-3 font-bold">ابدأ فورًا</h3><p class="mt-2 text-sm leading-7 text-muted">سلّم الملفات أو الوصول بالطريقة المناسبة.</p></article></div>
    </div>
  </section>

  <section class="bg-coral text-white"><div class="container flex flex-col justify-between gap-6 py-14 sm:flex-row sm:items-center"><div><p class="text-sm font-bold text-white/75">جاهز تبني منتجك؟</p><h2 class="mt-2 font-heading text-3xl font-bold">ابدأ من منتج يوفر عليك الوقت.</h2></div><a href="#products" class="rounded-xl bg-[#102a2b] px-7 py-3.5 font-bold transition hover:bg-[#173b38]">تصفح المنتجات</a></div></section>
</BaseLayout>
