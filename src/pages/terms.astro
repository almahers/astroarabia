---
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout
  title="الشروط والأحكام | AstroArabia"
  description="الشروط والأحكام لاستخدام موقع AstroArabia."
>
  <section class="container max-w-3xl py-16 sm:py-24">
    <p class="eyebrow">قانوني</p><h1 class="mt-5 font-heading text-4xl font-bold">
      الشروط والأحكام
    </h1><div class="mt-10 space-y-8 leading-9 text-muted">
      <section>
        <h2 class="font-heading text-xl font-bold text-ink">استخدام الموقع</h2><p class="mt-3">
          يمكن استخدام محتوى الموقع للتعرف على الخدمات والقالب، مع الالتزام بالقوانين وحقوق الملكية
          المعمول بها.
        </p>
      </section><section>
        <h2 class="font-heading text-xl font-bold text-ink">المحتوى التجريبي</h2><p class="mt-3">
          النصوص والأسعار والنماذج المعروضة أمثلة قابلة للتعديل وليست عرضاً تجارياً ملزماً.
        </p>
      </section><section>
        <h2 class="font-heading text-xl font-bold text-ink">التحديثات</h2><p class="mt-3">
          قد نحدّث هذه الشروط عند تغيير الخدمات أو طريقة استخدام الموقع.
        </p>
      </section>
    </div>
  </section>
</BaseLayout>
